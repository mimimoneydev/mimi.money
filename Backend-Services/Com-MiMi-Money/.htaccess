RewriteEngine On

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

Options -Indexes

ServerSignature Off

<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(config|database)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteRule ^(application/config|system)/ - [F,L]

    RewriteRule ^image/profile/(.+)$ safe_files.php?images=1&profile=1&hash=$1 [L,QSA]
    RewriteRule ^image/profilePreview/(.+)$ safe_files.php?images=1&profilePreview=1&hash=$1 [L,QSA]
    RewriteRule ^image/profilePreviewHolder/(.+)$ safe_files.php?images=1&profilePreviewHolder=1&hash=$1 [L,QSA]
    RewriteRule ^image/rowImage/(.+)$ safe_files.php?images=1&rowImage=1&hash=$1 [L,QSA]
    RewriteRule ^image/settings/(.+)$ safe_files.php?images=1&settings=1&hash=$1 [L,QSA]
    RewriteRule ^image/editProfile/(.+)$ safe_files.php?images=1&editProfile=1&hash=$1 [L,QSA]
    RewriteRule ^image/messageImage/(.+)$ safe_files.php?images=1&messageImage=1&hash=$1 [L,QSA]
    RewriteRule ^image/messageImageHolder/(.+)$ safe_files.php?images=1&messageImageHolder=1&hash=$1 [L,QSA]

    RewriteRule ^video/messageVideo/(.+)$ safe_files.php?videos=1&messageVideo=1&hash=$1 [L,QSA]
    RewriteRule ^video/messageVideoThumbnail/(.+)$ safe_files.php?videos=1&messageVideoThumbnail=1&hash=$1 [L,QSA]

    RewriteRule ^audio/messageAudio/(.+)$ safe_files.php?audios=1&messageAudio=1&hash=$1 [L,QSA]

    RewriteRule ^document/messageDocument/(.+)$ safe_files.php?documents=1&messageDocument=1&hash=$1 [L,QSA]
    RewriteRule ^backup/messageBackup/(.+)$ safe_files.php?documents=1&messageBackup=1&hash=$1 [L,QSA]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/css text/xml text/javascript application/javascript application/json application/xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 week"
    ExpiresByType video/mp4 "access plus 1 week"
</IfModule>
