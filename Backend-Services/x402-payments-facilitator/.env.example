# Bind only to loopback; Apache terminates public HTTPS.
HOST=127.0.0.1
PORT=4402
TRUST_PROXY=1
LOG_LEVEL=info

# Required for verify/settle. Generate securely; never commit this file.
EVM_PRIVATE_KEY=0x...

# Comma-separated CAIP-2 identifiers. These defaults are tested by the app.
EVM_NETWORKS=eip155:8453,eip155:84532,eip155:137,eip155:42161,eip155:421614,eip155:1,eip155:43114,eip155:42220,eip155:143,eip155:4326,eip155:31612

# Optional per-chain RPC overrides. Public defaults are provided but dedicated
# authenticated endpoints are strongly recommended for production settlement.
RPC_1=
RPC_137=
RPC_143=
RPC_4326=
RPC_8453=
RPC_84532=
RPC_31612=
RPC_42161=
RPC_421614=
RPC_42220=
RPC_43114=

# If set, every verification is screened first. The endpoint receives the
# payment payload/requirements and must respond with {"allowed":true}.
# COMPLIANCE_WEBHOOK_URL=https://screening-provider.example/v1/x402/screen
# COMPLIANCE_WEBHOOK_TOKEN=
COMPLIANCE_FAIL_CLOSED=true
COMPLIANCE_TIMEOUT_MS=4000

# Monthly pricing metadata and local settlement meter.
FREE_SETTLEMENTS_PER_MONTH=1000
SETTLEMENT_FEE_USD=0.001
USAGE_DATA_FILE=./data/usage.json
