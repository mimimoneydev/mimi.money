HOST=127.0.0.1
PORT=4411
INTERNAL_TOKEN=replace-with-a-long-random-token
CIRCLE_AGENT_WALLET_ADDRESS=0x...
CIRCLE_CLI_PATH=/usr/local/bin/circle
CIRCLE_CHAIN=BASE
# Local-key fallback only; omit when using a Circle Agent Wallet.
PAYER_PRIVATE_KEY=
AGENTICOUS_URL=https://agenticous.mimi.money
AGENTICOUS_SELLER_ADDRESS=0x...
PAYMENT_NETWORK=eip155:8453
PAYMENT_AMOUNT_ATOMIC=10000
REQUEST_TIMEOUT_MS=30000
AUTONOMOUS_TRANSFERS_ENABLED=false
MAXIMUM_AUTONOMOUS_TRANSFER_USD=1.00
# Required before autonomous transfers can be enabled.
ALLOWED_TRANSFER_RECIPIENTS=
X402_PURCHASES_ENABLED=false
MAXIMUM_X402_PURCHASE_USD=0.05
ALLOWED_X402_HOSTS=
# Optional HTTPS RPC overrides, for example:
# RPC_URL_8453=https://your-base-rpc.example
