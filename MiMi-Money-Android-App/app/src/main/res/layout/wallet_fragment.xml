<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context="com.money.mimi.fragments.home.WalletFragment">

    <LinearLayout
        android:id="@+id/wallet_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header with settings icon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/wallet_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/btn_scan_dapps_qr"
                android:text="@string/wallet_balance_placeholder"
                android:textColor="@color/colorPrimaryText"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_scan_dapps_qr"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignTop="@id/btn_dapps"
                android:layout_alignBottom="@id/btn_dapps"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/btn_dapps"
                android:background="@android:color/transparent"
                android:contentDescription="@string/wallet_scan_dapp_qr"
                android:padding="8dp"
                android:src="@drawable/ic_photo_camera_gray_24dp" />

            <Button
                android:id="@+id/btn_dapps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@id/wallet_balance"
                android:layout_alignBottom="@id/wallet_balance"
                android:background="@drawable/bg_wallet_button"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/wallet_action_dapps"
                android:textColor="@color/colorWhite" />

            <Button
                android:id="@+id/btn_ai_agents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_dapps"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_wallet_button"
                android:minWidth="119dp"
                android:minHeight="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:scaleY="0.9"
                android:text="@string/wallet_action_ai_agents"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite" />

            <TextView
                android:id="@+id/wallet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/wallet_balance"
                android:layout_marginTop="4dp"
                android:text="@string/wallet_title_my_wallet"
                android:textColor="@color/colorSecondaryText" />

        </RelativeLayout>

        <!-- Quick actions row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:weightSum="4">

            <Button
                android:id="@+id/btn_send"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wallet_button"
                android:text="@string/wallet_action_send"
                android:textColor="@color/colorWhite" />

            <Button
                android:id="@+id/btn_receive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wallet_button"
                android:text="@string/wallet_action_receive"
                android:textColor="@color/colorWhite" />

            <Button
                android:id="@+id/btn_bank"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wallet_button"
                android:text="@string/wallet_action_bank"
                android:textColor="@color/colorWhite" />

            <Button
                android:id="@+id/btn_pay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wallet_button"
                android:text="@string/wallet_action_pay"
                android:textColor="@color/colorWhite" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wallet_network_label"
                android:textColor="@color/colorSecondaryText"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_wallet_network"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:popupBackground="@drawable/bg_dialog_popup_rounded" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wallet_network_custom_help"
                android:textColor="@color/colorSecondaryText"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_add_network"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_wallet_button"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp"
                    android:text="@string/wallet_network_add"
                    android:textColor="@color/colorWhite" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_delete_network"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_wallet_button"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp"
                    android:text="@string/wallet_network_delete"
                    android:textColor="@color/colorWhite"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/wallet_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/colorAccent"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/colorPrimaryText"
            app:tabTextColor="@color/colorSecondaryText" />

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/wallet_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/wallet_child_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:colorBackground"
        android:visibility="gone" />

</FrameLayout>
