<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="AppTheme.Base">

    </style>

    <style name="AppTheme.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlHighlight">@color/colorPrimaryLight</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- ActionMode Styles -->
        <item name="android:actionModeBackground">@color/colorActionMode</item>
        <item name="android:backgroundStacked">@color/colorActionMode</item>
        <item name="android:backgroundSplit">@color/colorActionMode</item>

        <!-- Popup theme for overflow menus -->
        <item name="actionBarPopupTheme">@style/AppPopupTheme</item>
        <item name="alertDialogTheme">@style/AppRoundedAlertDialog</item>
        <item name="android:alertDialogTheme">@style/AppRoundedAlertDialog</item>
        <item name="spinnerStyle">@style/AppRoundedSpinner</item>
        <item name="android:spinnerStyle">@style/AppRoundedSpinner</item>
        <item name="popupWindowStyle">@style/AppRoundedPopupWindow</item>
        <item name="android:popupWindowStyle">@style/AppRoundedPopupWindow</item>
        <item name="listPopupWindowStyle">@style/AppRoundedListPopupWindow</item>
        <item name="android:listPopupWindowStyle">@style/AppRoundedListPopupWindow</item>
    </style>

    <!-- crop style-->

    <style name="Theme.AppCompat.Translucent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:background">#33000000
        </item> <!-- Or any transparency or color you need -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>


    <style name="option" parent="Theme.AppCompat.Light">

    </style>

    <style name="Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:textColor">@android:color/transparent</item>
    </style>

    <style name="CustomTabPageIndicator.Text" parent="android:TextAppearance.Medium">
        <item name="android:textColor">@drawable/bg_tabs_text_color</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBar.Fullscreen" parent="AppTheme.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="ToolbarSubTitle" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Default (light) popup theme for Toolbar/overflow menus -->
    <style name="AppPopupTheme" parent="ThemeOverlay.AppCompat.Light" />

    <style name="AppRoundedAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:colorBackground">@color/colorDialogSurface</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppDialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppDialogNegativeButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AppDialogPositiveButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AppDialogNegativeButton</item>
    </style>

    <style name="AppDialogPositiveButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/dialog_action_positive_text</item>
    </style>

    <style name="AppDialogNegativeButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/dialog_action_negative_text</item>
    </style>

    <style name="AppRoundedPopupWindow" parent="@style/Widget.AppCompat.PopupWindow">
        <item name="android:popupBackground">@drawable/bg_dialog_popup_rounded</item>
    </style>

    <style name="AppRoundedListPopupWindow" parent="@style/Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@drawable/bg_dialog_popup_rounded</item>
    </style>

    <style name="AppRoundedSpinner" parent="@style/Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_dialog_popup_rounded</item>
    </style>


    <!-- les cardView styles -->
    <style name="Widget.CardContent" parent="android:Widget">
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">24dp</item>
        <item name="android:orientation">vertical</item>
    </style>


    <style name="TextAppearance.WhatsClone.Title.Collapsed" parent="android:TextAppearance">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.WhatsClone.Title.Expanded" parent="android:TextAppearance">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextInputEditTextStyle">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/colorPrimaryText</item>
        <item name="android:textColorHint">@color/colorSecondaryText</item>
        <item name="android:padding">15dp</item>
    </style>

    <!--buttons style-->

    <style name="Buttons">
        <item name="android:textColor">@drawable/bg_buttons_text_color_welcome</item>
        <item name="android:background">@drawable/bg_buttons_welcome</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="ButtonsBackup">
        <item name="android:textColor">@drawable/bg_buttons_text_color_backup</item>
        <item name="android:background">@drawable/bg_buttons_backup</item>
        <item name="android:padding">6dp</item>
    </style>


    <style name="ButtonDelete">
        <item name="android:textColor">@drawable/bg_buttons_text_color_welcome</item>
        <item name="android:background">@drawable/bg_buttons_delete_account</item>
        <item name="android:padding">6dp</item>
    </style>




</resources>
