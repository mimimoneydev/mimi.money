            android:name="com.money.mimi.activities.groups.AddNewMembersToGroupActivity"
            android:configChanges="locale"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>
            <meta-data
